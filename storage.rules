rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    /* Profile avatars and banners — one file per user, overwritten on
       every re-upload. Filename IS the uid (no extension), so a user
       can only write their own file. Publicly readable since other
       users see these photos too (feed, friends, leaderboards). */
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /banners/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
